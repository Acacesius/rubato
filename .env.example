# Copy to .env and adjust. Every setting is optional.

# Host port and interface. 127.0.0.1 = reachable only through a reverse proxy
# or tunnel on this machine. 0.0.0.0 exposes it to your whole network
# (Docker bypasses host firewalls such as UFW).
PORT=8766
BIND=127.0.0.1

# Public address guests and the speaker use, for the invite link, QR code and
# speaker link, e.g. https://rubato.example.com or https://example.com/rubato. Normally set in the setup
# wizard; this overrides it.
PUBLIC_URL=

# Only if your proxy serves rubato under a path (e.g. /rubato) and passes that
# path through unchanged. Proxies that strip it (Tailscale serve --set-path,
# Caddy handle_path) need nothing here.
ROOT_PATH=

# Network of your reverse proxy as seen from the container. X-Forwarded-For is
# only trusted from here. The default covers Docker's bridge networks.
TRUSTED_PROXY_CIDR=172.16.0.0/12

# Key for the host dashboard. Leave blank: the setup wizard generates one and
# stores it in config/. Setting it here overrides that.
HOST_KEY=

# Key for the speaker page (/speaker#k=...). Leave blank: the wizard generates
# one and the dashboard can rotate it. Setting it here overrides both.
SPEAKER_KEY=

# Song the YouTube link check uses to detect Premium (256k AAC, format 141).
# Default: BSTsnWoslP4 (Queen - Bohemian Rhapsody). Change it if that's
# unavailable in your country.
PROBE_VIDEO_ID=

# Speed cap for fetching songs from YouTube, in MB/s (0 = no cap). Songs
# download one at a time, so one download can't fill your link.
DOWNLOAD_RATE=2

# Artwork cache size in ./cache, in MB.
ART_CACHE_MB=300

# UID/GID the container runs as. It must be able to write ./config and ./cache.
RUBATO_UID=1000
RUBATO_GID=1000

# Container memory limit. Tracks are held in RAM (current, next, a couple recent).
MEM_LIMIT=1g

# Only for ytmusicapi OAuth (optional).
YTM_CLIENT_ID=
YTM_CLIENT_SECRET=
